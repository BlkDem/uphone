# UPhone Server Configuration
# Copy to /etc/uphone/uphone.env and edit
# Protect this file: chmod 600 /etc/uphone/uphone.env

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=uphone
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=uphone

# Server
SERVER_PORT=8080
UPLOAD_DIR=/var/lib/uphone/uploads
UPLOAD_BASE_URL=http://SERVER_IP
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

# Media previews (thumbnail width in px for images/video frames)
THUMBNAIL_WIDTH=360

# Firebase Cloud Messaging (optional — leave empty to disable push)
# Path to Firebase service-account.json
FCM_CREDENTIALS=/etc/uphone/firebase-service-account.json

# S3-compatible storage (optional — leave empty to use local filesystem)
# For cloud.ru / AWS S3 use the AWS_* variables:
# AWS_ACCESS_KEY_ID=2836bfa0-...:e6e6975d0eda7398e21deebc619ac85d
# AWS_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_DEFAULT_REGION=ru-central-1
# AWS_BUCKET=bucket-uphone
# AWS_URL=https://s3.cloud.ru
# AWS_ENDPOINT=https://s3.cloud.ru
# AWS_USE_PATH_STYLE_ENDPOINT=true
#
# Legacy MinIO variables (still supported, AWS_* take precedence):
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=uphone_minio
# MINIO_SECRET_KEY=CHANGE_ME
# MINIO_BUCKET=uphone-uploads
# MINIO_USE_SSL=false
